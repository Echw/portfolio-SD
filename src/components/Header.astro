---
import { contentFor } from '../i18n/content';
import { localizedPath } from '../i18n/routes';
const { profile, locale, t } = contentFor(Astro.currentLocale);
interface Props { home?: boolean }
const { home = true } = Astro.props;
const homeLink = (hash: string) => home ? hash : localizedPath(locale) + hash;
---
<a class="skip-link" href="#main">{t.skip}</a>
<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="site-name" href={homeLink('#top')} aria-label={`${profile.name}, ${home ? t.backTop : t.home}`}>{profile.name}</a>
    <nav aria-label={t.mainNavigation}>
      <a class="text-link" href={homeLink('#about')}>{t.about}</a>
      <a class="text-link" href={homeLink('#work')}>{t.work}</a>
      <a class="text-link" href="#contact">{t.contact}</a>
      <span class="language-switch" role="group" aria-label={t.language}>
        {(['pl', 'en'] as const).map((language) => (
          <a class="text-link" data-language-link href={localizedPath(language, Astro.url.pathname)} lang={language} hreflang={language} aria-current={language === locale ? 'true' : undefined} aria-label={language === 'pl' ? 'Wersja polska' : 'English version'}>{language.toUpperCase()}</a>
        ))}
      </span>
    </nav>
  </div>
</header>
<script>
  // Astro intercepts links after this capture listener; keep the current section.
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-language-link]') : null;
    if (link) {
      const destination = new URL(link.href);
      destination.hash = window.location.hash;
      link.href = destination.href;
    }
  }, true);
</script>

---
import { profile, heroHeadlines } from '../data/portfolio';
---
<section id="top" class="hero container" aria-labelledby="hero-title" data-hero>
  <h1 id="hero-title" class="sr-only">Full-stack developer building web applications and AI tools.</h1>
  <div class="hero-rotator" aria-hidden="true">
    {heroHeadlines.map((headline, index) => (
      <div class:list={['hero-slide', { 'hero-slide--sentence': index > 0 }]} data-hero-slide>
        {headline.lines.map((line, lineIndex) => (
          <div class:list={['hero-line', { 'hero-line--accent': lineIndex === 1 }]}>
            <span class="hero-line-reserve">{line}</span>
            <span class="hero-line-output"><span data-hero-text>{index === 0 ? line : ''}</span></span>
          </div>
        ))}
      </div>
    ))}
  </div>
  <div class="hero-foot">
    <p>{profile.heroDescription}</p>
    <div class="hero-actions">
      <button class="hero-pause" type="button" data-hero-pause aria-label="Pause headline animation" aria-pressed="false" hidden>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path class="pause-icon" d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="2" />
          <path class="play-icon" d="m8 5 11 7-11 7Z" fill="currentColor" />
        </svg>
      </button>
      <a class="scroll-link text-link" href="#work">
        <svg class="scroll-mouse" viewBox="0 0 24 34" width="20" height="28" aria-hidden="true">
          <rect x="3" y="2" width="18" height="29" rx="9" fill="none" stroke="currentColor" stroke-width="1.3" />
          <path class="scroll-wheel" d="M12 8v5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span>Scroll to explore</span>
      </a>
    </div>
  </div>
</section>

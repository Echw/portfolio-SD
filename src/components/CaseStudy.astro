---
import { Picture } from 'astro:assets';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import CaseStudyFigure from './CaseStudyFigure.astro';
import type { CaseStudy } from '../data/case-studies';
import { contentFor } from '../i18n/content';
import { localizedPath } from '../i18n/routes';
const { profile, locale, t } = contentFor(Astro.currentLocale);
import '../styles/case-study.css';
interface Props { study: CaseStudy }
const { study } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${study.title} — ${study.subtitle}`,
  description: study.description,
  author: { '@type': 'Person', name: profile.name },
  inLanguage: locale,
  about: { '@type': 'WebSite', name: study.title, url: study.url },
};
---
<PortfolioLayout title={`${study.title} — ${t.caseStudy} · ${profile.name}`} description={study.description} transitionLabel={study.title} schema={schema}>
  <article class="case-study" aria-labelledby="case-title">
    <section id="top" class="case-hero container" aria-labelledby="case-title">
      <a class="case-back text-link" href={localizedPath(locale) + "#work"}><span aria-hidden="true">←</span> {t.allProjects}</a>
      <div class:list={['case-hero-heading', { 'case-hero-heading--multiline': study.titleLines }]}>
        <h1 id="case-title">{study.titleLines ? study.titleLines.map((line, index) => <>{index > 0 && ' '}<span class="case-title-line">{line}</span></>) : study.title}</h1>
        <div class="case-hero-summary">
          <p>{study.subtitle}</p>
          <a class="text-link" href={study.url} target="_blank" rel="noopener noreferrer">{t.visitLive} <span aria-hidden="true">↗</span><span class="sr-only">{t.newTab}</span></a>
        </div>
      </div>
      <div class="case-cover" style={study.coverPosition ? { '--case-cover-position': study.coverPosition } : undefined}>
        <Picture src={study.cover} formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1440, 1920]} sizes="(min-width: 1680px) 1512px, 90vw" alt={study.coverAlt} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="case-hero-foot">
        <span>{t.independentWork}</span>
        <a class="text-link" href={`#${study.sections[0].id}`}>{t.exploreProject} <span aria-hidden="true">↓</span></a>
      </div>
    </section>
    {study.sections.map((section, sectionIndex) => (
      <section id={section.id} class:list={['case-section container', { 'case-section--text': !section.figures?.length }]} aria-labelledby={`case-${section.id}-title`}>
        <div class="case-section-copy" data-reveal>
          <h2 id={`case-${section.id}-title`}>{section.title}</h2>
          <div class="case-prose">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
        {sectionIndex === 0 && (
          <div class="case-contribution" data-reveal>
            <h3>{t.contribution}</h3>
            <ul>{study.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
          </div>
        )}
        {section.figures?.map((figure, index) => <CaseStudyFigure figure={figure} detail={index > 0} />)}
        {sectionIndex === study.sections.length - 1 && (
          <>
            <div class="case-technologies" data-reveal>
              <h3>{t.technologies}</h3>
              <ul>{study.technologies.map((technology) => <li>{technology}</li>)}</ul>
            </div>
            <div class="case-end-links" data-reveal>
              <a class="text-link" href={localizedPath(locale) + "#work"}><span aria-hidden="true">←</span> {t.backWork}</a>
              <a class="text-link" href={study.url} target="_blank" rel="noopener noreferrer">{t.visit} {study.title} <span aria-hidden="true">↗</span><span class="sr-only">{t.newTab}</span></a>
            </div>
          </>
        )}
      </section>
    ))}
  </article>
</PortfolioLayout>

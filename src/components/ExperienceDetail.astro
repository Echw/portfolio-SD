---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import type { Experience } from '../data/experience';
import { contentFor } from '../i18n/content';
import { localizedPath } from '../i18n/routes';
const { profile, locale, t } = contentFor(Astro.currentLocale);
import '../styles/case-study.css';
import '../styles/experience-detail.css';

interface Props { experience: Experience }
const { experience: entry } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `${entry.company} — ${t.professionalExperience} · ${profile.name}`,
  description: entry.description,
  inLanguage: locale,
  author: { '@type': 'Person', name: profile.name },
  about: { '@type': 'Organization', name: entry.company },
};
---
<PortfolioLayout title={`${entry.company} — ${t.professionalExperience} · ${profile.name}`} description={entry.description} transitionLabel={entry.company} schema={schema}>
  <article class="case-study experience-detail" aria-labelledby="experience-detail-title">
    <header id="top" class="experience-hero container">
      <a class="case-back text-link" href={localizedPath(locale) + "#experience"}><span aria-hidden="true">←</span> {t.backExperience}</a>
      <p class="eyebrow">{t.professionalExperience}</p>
      <h1 id="experience-detail-title">{entry.company}</h1>
      <div class="experience-meta" data-reveal>
        <p class="experience-detail-role">{entry.role}</p>
        <div class="experience-dates">
          <p>{entry.period}</p>
          {entry.arrangement && <p>{entry.arrangement}</p>}
        </div>
      </div>
    </header>
    <section class="experience-section container" aria-labelledby="role-title">
      <div class="case-section-copy" data-reveal>
        <h2 id="role-title">{t.role}</h2>
        <div class="case-prose"><p>{entry.overview}</p></div>
      </div>
    </section>
    {entry.contributions?.length && (
      <section class="experience-section container" aria-labelledby="contribution-title">
        <div class="case-section-copy" data-reveal>
          <h2 id="contribution-title">{t.contribution}</h2>
          <ul class="case-prose experience-contributions">{entry.contributions.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>
    )}
    {entry.projects?.map((project) => (
      <section id={project.id} class="experience-section container" aria-labelledby={`${project.id}-title`}>
        <div class="case-section-copy" data-reveal>
          <h2 id={`${project.id}-title`}>{project.title}</h2>
          <div class="case-prose">
            <p class="experience-project-context">{project.context}</p>
            {project.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <div class="experience-references">
              <h3>{project.references.length === 1 ? t.reference : t.references}</h3>
              <ul>{project.references.map((reference) => (
                <li><a class="text-link" href={reference.url} target="_blank" rel="noopener noreferrer">{reference.label} <span aria-hidden="true">↗</span><span class="sr-only">{t.newTab}</span></a></li>
              ))}</ul>
            </div>
          </div>
        </div>
      </section>
    ))}
    <section class="experience-section container" aria-labelledby="technologies-title">
      <div class="case-technologies" data-reveal>
        <div>
          <h2 id="technologies-title">{t.technologies}</h2>
          <p class="experience-technology-note">{t.acrossRole}</p>
        </div>
        <ul>{entry.technologies.map((technology) => <li>{technology}</li>)}</ul>
      </div>
    </section>
    <div class="experience-end container" data-reveal>
      <a class="text-link" href={localizedPath(locale) + "#experience"}><span aria-hidden="true">←</span> {t.backExperience}</a>
    </div>
  </article>
</PortfolioLayout>

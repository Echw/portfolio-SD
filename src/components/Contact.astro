---
import { contentFor } from '../i18n/content';
import { localizedPath } from '../i18n/routes';
const { profile, locale, t } = contentFor(Astro.currentLocale);
interface Props { home?: boolean }
const { home = true } = Astro.props;
const navigation = [
  { label: t.about, href: '#about' },
  { label: t.stack, href: '#stack' },
  { label: t.experience, href: '#experience' },
  { label: t.work, href: '#work' },
];
---
<footer id="contact" class="contact container section" aria-labelledby="contact-title">
  <p class="eyebrow" data-footer-part>{t.contactIntro}</p>
  <h2 id="contact-title" class="contact-title">
    {t.footerLines.map((line, index) => (
      <span class:list={['footer-line', { 'footer-line--accent': index === 1 }]}>{line.split(' ').map((word, wordIndex) => <>{wordIndex > 0 && ' '}<span data-footer-word>{word}</span></>)}</span>
    ))}
  </h2>
  <div class="footer-columns" data-footer-part>
    <nav aria-label={t.footerNavigation}>
      <h3 class="eyebrow">{t.explore}</h3>
      <ul>{navigation.map((item) => <li><a class="text-link" href={home ? item.href : localizedPath(locale) + item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <div class="footer-contact">
      <h3 class="eyebrow">{t.sayHello}</h3>
      <a class="footer-email text-link" href={'mailto:' + profile.email}>{profile.email}</a>
      <p>{t.services[0]}<br />{t.services[1]}</p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <a class="text-link arrow-link" href="#top">{t.backTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

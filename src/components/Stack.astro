---
import { stack } from '../data/portfolio';
import StackIcon from './StackIcon.astro';
---
<section id="stack" class="stack container section" aria-labelledby="stack-title">
  <div class="stack-heading" data-reveal>
    <p class="eyebrow">Stack</p>
    <h2 id="stack-title" class="stack-title">Tools I build with.</h2>
  </div>
  <ul class="stack-list" aria-label="Technologies and tools">
    {stack.map((tool) => (
      <li class="stack-card" data-glow-card>
        <div class="stack-surface glow-surface" data-glow-surface data-stack-tag>
          <StackIcon tool={tool} />
          <span class="stack-label">{tool}</span>
        </div>
      </li>
    ))}
  </ul>
</section>

---
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/standard-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import About from '../components/About.astro';
import Stack from '../components/Stack.astro';
import Contact from '../components/Contact.astro';
import Backdrop from '../components/Backdrop.astro';
import { profile } from '../data/portfolio';
import entryBootstrap from '../scripts/entry-bootstrap.js?raw';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'Senior Full-Stack Developer',
  description: profile.description,
  sameAs: [profile.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={profile.description} />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline set:html={entryBootstrap} />
    <title>{profile.name} — Full-Stack Developer · AI/LLM</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.name} — Full-Stack Developer`} />
    <meta property="og:description" content={profile.description} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:alt" content="Damian Stojaniuk — Full-stack developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <Backdrop />
    <div class="entry-curtain" data-entry-curtain aria-hidden="true"></div>
    <div class="cursor-layer" data-cursor-layer aria-hidden="true" hidden>
      <div class="cursor-dot" data-cursor-dot><span></span></div>
      <div class="cursor-ring" data-cursor-ring><span></span></div>
    </div>
    <Header />
    <main id="main" tabindex="-1">
      <Hero />
      <About />
      <Stack />
      <Experience />
      <Projects />
      <Contact />
    </main>
    <script>
      import { initializePortfolio } from '../scripts/motion';
      initializePortfolio();
    </script>
  </body>
</html>

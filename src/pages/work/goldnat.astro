---
import { Picture } from 'astro:assets';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import CaseStudyFigure from '../../components/CaseStudyFigure.astro';
import { goldnat } from '../../data/case-studies';
import { profile } from '../../data/portfolio';
import '../../styles/case-study.css';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Goldnat — vehicle catalogue and sales workflows',
  description: goldnat.description,
  author: { '@type': 'Person', name: profile.name },
  inLanguage: 'en',
  about: { '@type': 'WebSite', name: 'Goldnat', url: goldnat.url },
};
---
<PortfolioLayout title={`Goldnat — Case study · ${profile.name}`} description={goldnat.description} transitionLabel="Goldnat" schema={schema}>
  <article class="case-study" aria-labelledby="case-title">
    <section id="top" class="case-hero container" aria-labelledby="case-title">
      <a class="case-back text-link" href="/#work"><span aria-hidden="true">←</span> All projects</a>
      <div class="case-hero-heading">
        <h1 id="case-title">{goldnat.title}</h1>
        <div class="case-hero-summary">
          <p>{goldnat.subtitle}</p>
          <a class="text-link" href={goldnat.url} target="_blank" rel="noopener noreferrer">Visit live website <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </div>
      <div class="case-cover">
        <Picture src={goldnat.cover} formats={['avif']} fallbackFormat="webp" widths={[640, 960, 1440, 1920]} sizes="(min-width: 1680px) 1512px, 90vw" alt={goldnat.coverAlt} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <div class="case-hero-foot">
        <span>Independent work</span>
        <a class="text-link" href="#context">Explore the project <span aria-hidden="true">↓</span></a>
      </div>
    </section>
    {goldnat.sections.map((section) => (
      <section id={section.id} class:list={['case-section container', { 'case-section--text': !section.figures }]} aria-labelledby={`case-${section.id}-title`}>
        <div class="case-section-copy" data-reveal>
          <h2 id={`case-${section.id}-title`}>{section.title}</h2>
          <div class="case-prose">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
        </div>
        {section.id === 'context' && (
          <div class="case-contribution" data-reveal>
            <h3>My contribution</h3>
            <ul>{goldnat.contributions.map((contribution) => <li>{contribution}</li>)}</ul>
          </div>
        )}
        {section.figures?.map((figure, index) => <CaseStudyFigure figure={figure} detail={index > 0} />)}
        {section.id === 'delivered' && (
          <>
            <div class="case-technologies" data-reveal>
              <h3>Selected technologies</h3>
              <ul>{goldnat.technologies.map((technology) => <li>{technology}</li>)}</ul>
            </div>
            <div class="case-end-links" data-reveal>
              <a class="text-link" href="/#work"><span aria-hidden="true">←</span> Back to independent work</a>
              <a class="text-link" href={goldnat.url} target="_blank" rel="noopener noreferrer">Visit Goldnat <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
            </div>
          </>
        )}
      </section>
    ))}
  </article>
</PortfolioLayout>

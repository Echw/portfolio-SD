---
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/standard-italic.css';
import '@fontsource-variable/inter';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import transitionStyles from '../styles/transitions.css?raw';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Backdrop from '../components/Backdrop.astro';
import { profile } from '../data/portfolio';
import entryBootstrap from '../scripts/entry-bootstrap.js?raw';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  transitionLabel?: string;
  schema?: Record<string, unknown>;
}
const { title, description, home = false, transitionLabel = 'Homepage', schema } = Astro.props;
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <ClientRouter fallback="swap" />
    <!-- Keep the idle overlay hidden before the first paint, including in dev. -->
    <style is:inline set:html={transitionStyles} />
    <meta name="portfolio-transition-label" content={transitionLabel} />
    {home && <script is:inline set:html={entryBootstrap} />}
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={home ? 'website' : 'article'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:image:alt" content={`${profile.name} — Full-stack developer`} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body data-page={home ? 'home' : 'case-study'}>
    <Backdrop />
    <div class="route-overlay" data-route-overlay aria-hidden="true" transition:persist="route-overlay">
      <div class="route-curtain" data-route-curtain></div>
      <div class="route-label" data-route-label>{transitionLabel}</div>
    </div>
    {home && <div class="entry-curtain" data-entry-curtain aria-hidden="true"></div>}
    <div class="cursor-layer" data-cursor-layer aria-hidden="true" hidden>
      <div class="cursor-dot" data-cursor-dot><span></span></div>
      <div class="cursor-ring" data-cursor-ring><span></span></div>
    </div>
    <Header home={home} />
    <main id="main" tabindex="-1">
      <slot />
      <Contact home={home} />
    </main>
    <script>
      import { initializeRouteTransitions } from '../scripts/route-transition';
      initializeRouteTransitions();
    </script>
  </body>
</html>
